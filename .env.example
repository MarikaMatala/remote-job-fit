# OPTIONAL EMAIL AND LOCAL DATABASE SETTINGS
# Copy this file to .env on your own computer and edit .env only.
# Never put real values in this example file or commit your .env file.
#
# SMTP_HOST: Hostname of your email provider's SMTP server.
# SMTP_PORT: SMTP port. 587 is commonly used with STARTTLS; check your provider.
# SMTP_USERNAME: Login name required by your SMTP provider (if applicable).
# SMTP_PASSWORD: SMTP password or provider-issued app password. Never use
#   your normal account password if your provider recommends an app password.
# SMTP_FROM: Sender address accepted by your SMTP provider.
# SMTP_TO: Destination address where you want to receive digests.
# SMTP_USE_TLS: true to request STARTTLS; false only if your provider explicitly
#   documents a different secure setup. Do not send credentials over plaintext.
#
# Leave SMTP values empty if you do not want to use email digests.
# The current public job feeds do not need API keys. If you add a future
# integration that requires a secret, put it only in your private .env file
# and read it from the Python backend. Never put secrets in frontend files.
# DATABASE_PATH: Local path for the SQLite database. The default is ignored by Git.

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=
SMTP_USE_TLS=true

DATABASE_PATH=data/jobs.sqlite3
